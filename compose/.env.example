# Copy to compose/.env and fill in. compose/.env is gitignored and must never be committed.
# Every variable is listed here with no value. Do not quote values: Docker Compose
# passes quotes through literally.
#
# scripts/gen-secrets.sh creates compose/.env if it is missing, appends any variable
# listed here that is absent, and fills the generated secrets without overwriting a
# value that is already set.

# --- Network ---
# Host LAN IP that published ports bind to. Never 0.0.0.0. Expected: 192.168.1.60
BIND_ADDRESS=

# --- SeaweedFS (S3 API) ---
# Carried over from the running ai-platform-stack deployment. NEVER regenerated by
# gen-secrets.sh: seed them from /opt/ai-platform-stack/.env on the host.
SEAWEEDFS_S3_PORT=
SEAWEEDFS_S3_ACCESS_KEY=
SEAWEEDFS_S3_SECRET_KEY=
SEAWEEDFS_VOLUME_SIZE_LIMIT_MB=
SEAWEEDFS_VOLUME_MAX=

# --- Qdrant ---
# Carried over from the running deployment, like the SeaweedFS keys.
QDRANT_REST_PORT=
QDRANT_API_KEY=

# --- Langfuse (v4) ---
# URL users and links use. Compose default: http://192.168.1.60:3000
NEXTAUTH_URL=
# Host port for langfuse-web (LAN only). Compose default: 3000
LANGFUSE_WEB_PORT=
# Generated by gen-secrets.sh. SALT must stay stable: changing it invalidates every API key.
SALT=
# 64 hex characters. Generated by gen-secrets.sh.
ENCRYPTION_KEY=
NEXTAUTH_SECRET=

# Headless init of the organisation, project, API keys and first user. Applied on
# first boot and idempotent afterwards. Compose supplies the defaults noted below.
# LANGFUSE_INIT_ORG_ID default: ai-platform
LANGFUSE_INIT_ORG_ID=
# LANGFUSE_INIT_ORG_NAME default: AI Platform
LANGFUSE_INIT_ORG_NAME=
# LANGFUSE_INIT_PROJECT_ID default: shared
LANGFUSE_INIT_PROJECT_ID=
# LANGFUSE_INIT_PROJECT_NAME default: shared
LANGFUSE_INIT_PROJECT_NAME=
# Project key pair applications use. Generated by gen-secrets.sh (pk-lf- and sk-lf- prefixes).
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
# LANGFUSE_INIT_USER_EMAIL default: admin@ai-platform.internal
LANGFUSE_INIT_USER_EMAIL=
# LANGFUSE_INIT_USER_NAME default: admin
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

# --- Postgres, ClickHouse, Valkey (Langfuse backends, demo tier, disposable) ---
# POSTGRES_USER default: langfuse
POSTGRES_USER=
# POSTGRES_DB default: langfuse
POSTGRES_DB=
# Postgres and ClickHouse read their passwords only when the volume is first
# initialised. Changing them later does not change the stored password.
POSTGRES_PASSWORD=
# CLICKHOUSE_USER default: clickhouse
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=

# --- LiteLLM gateway ---
# Host port for the gateway (LAN only). Compose default: 4000
LITELLM_PORT=
# Clients send this as a bearer token. Starts with sk-. Generated by gen-secrets.sh.
LITELLM_MASTER_KEY=
# Provider keys. Supplied by the operator, never generated.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
